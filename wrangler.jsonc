{
  "name": "text2typo-preview",
  "account_id": "a8d402fb6d8371d959f03478b920157f",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "AI_ENABLED": "true",
    "TOTAL_BUDGET_MICRO": "2000000",
    "INITIAL_SPEND_MICRO": "139108"
  },
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ALLOWANCE",
        "class_name": "Allowance"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Allowance"
      ]
    }
  ]
}
